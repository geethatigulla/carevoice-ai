# CareVoice voice service (Pipecat browser test call). Copy to voice/.env and fill in. Never commit .env.
# This service runs locally only. It needs no database credentials: every tool call goes to the backend.

# --- Speech (Sarvam AI) -----------------------------------------------------
SARVAM_API_KEY=
SARVAM_STT_MODEL=saaras:v3
SARVAM_TTS_MODEL=bulbul:v3
# Optional voice, e.g. priya (default), anushka, ...
SARVAM_SPEAKER=

# --- LLM (OpenAI) -----------------------------------------------------------
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4.1-mini

# --- Backend wiring ---------------------------------------------------------
BACKEND_URL=http://localhost:8000
# Must be the same value as INTERNAL_API_KEY in backend/.env (any long random string).
INTERNAL_API_KEY=
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
